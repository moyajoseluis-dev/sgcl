generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Usuario
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // V2.0 Relaciones
  pettyCashes PettyCash[]
}

// Roles
enum Role {
  ADMIN
  MANAGER
  USER
}

// ... (tu código existente de User y Role)

model Contract {
  id               Int              @id @default(autoincrement())
  title            String
  description      String?
  status           ContractStatus   @default(ACTIVE)
  type             ContractType     @default(SERVICE) // Para cambiar la UI dinámicamente
  startDate        DateTime
  endDate          DateTime
  amount           Float            // Monto total adjudicado
  entityName       String
  progress         Float            @default(0) // Porcentaje de avance (0-100)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  // Relaciones
  establishmentId Int?
  establishment   Establishment?   @relation(fields: [establishmentId], references: [id])
  costCenterId    Int?
  costCenter      CostCenter?      @relation(fields: [costCenterId], references: [id])
  pettyCash       PettyCash?
  stockMovements  StockMovement[]
  paymentStatuses PaymentStatus[]
  tasks           ContractTask[]
}

enum ContractStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
}

// ... tus modelos existentes ...

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ... tus modelos existentes ...

// --- MODELOS ACTUALIZADOS V2.1 ---

model Customer {
  id           Int              @id // ID de Laudus
  name         String
  vatId        String?
  email        String?
  phone        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  establishments Establishment[]
}

model Establishment {
  id          Int       @id @default(autoincrement())
  name        String    // Ej: Hospital Sotero del Río
  address     String?
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id])
  contracts   Contract[]
}
// --- NUEVOS MODELOS V2.0 ---

model CostCenter {
  id        Int       @id @default(autoincrement())
  laudusId  String    @unique // El ID del Centro de Costo en Laudus
  name      String
  budget    Float     @default(0) // Presupuesto anual/mensual traído de Laudus
  contracts Contract[]
}

model PettyCash {
  id             Int               @id @default(autoincrement())
  contractId     Int               @unique // Un fondo fijo por contrato/proyecto
  contract       Contract          @relation(fields: [contractId], references: [id])
  assignedAmount Float             @default(0) // Monto asignado inicial
  currentBalance Float             @default(0) // Saldo actual disponible
  responsibleId  Int
  responsible    User              @relation(fields: [responsibleId], references: [id])
  expenses       PettyCashExpense[]
}

model PettyCashExpense {
  id          Int           @id @default(autoincrement())
  pettyCashId Int
  pettyCash   PettyCash     @relation(fields: [pettyCashId], references: [id])
  amount      Float
  concept     String
  receiptUrl  String?       // URL de la boleta o factura subida
  status      ExpenseStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Workflow {
  id          Int      @id @default(autoincrement())
  name        String
  entityName  String   // A qué módulo aplica (ej. "CONTRACT", "PURCHASE")
  states      Json     // Configuración de estados y transiciones (máquina de estados)
  createdAt   DateTime @default(now())
}

// --- MÓDULO LOGÍSTICO V2.0 ---

model Product {
  id           Int             @id // El ID original de Laudus
  sku          String          @unique
  name         String
  unit         String?
  stockMovements StockMovement[]
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  productId   Int
  product     Product           @relation(fields: [productId], references: [id])
  contractId  Int?              // Si el movimiento va asociado a un contrato/obra
  contract    Contract?         @relation(fields: [contractId], references: [id])
  type        StockMovementType
  quantity    Float
  description String?
  createdAt   DateTime          @default(now())
}

enum StockMovementType {
  OUT_TO_SITE    // Salida de bodega central a bodega periférica (obra)
  CONSUMED       // Consumido en la obra (Se debe facturar)
  RETURNED       // Retorno de obra a bodega central (No se consumió)
}

model PaymentStatus {
  id          Int      @id @default(autoincrement())
  contractId  Int
  contract    Contract @relation(fields: [contractId], references: [id])
  number      Int      // Ej: Estado de Pago N°1
  period      String   // Ej: "Enero 2025"
  totalAmount Float
  status      String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, PAID
  createdAt   DateTime @default(now())
}

model ContractTask {
  id          Int      @id @default(autoincrement())
  contractId  Int
  contract    Contract @relation(fields: [contractId], references: [id])
  description String
  type        String   // PREVENTIVE, CORRECTIVE, WORK, OTHER
  status      String   @default("PENDING") // PENDING, EXECUTED, RESCHEDULED
  unitPrice   Float    @default(0) // Tarifa para la prefactura
  executedAt  DateTime?
  createdAt   DateTime @default(now())
}

enum ContractType {
  SERVICE       // Mantenciones, Climatización
  WORK          // Obras
  SUPPLY        // Suministros
  RENTAL        // Arriendos
}